{% doc %}
  @prompt
    A magazine-style editorial layout
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-magazine-layout-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    padding: {{ block.settings.spacing }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-magazine-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: {{ block.settings.grid_gap }}px;
  }

  .ai-magazine-feature-{{ ai_gen_id }} {
    grid-column: span 8;
    position: relative;
  }

  .ai-magazine-feature-image-{{ ai_gen_id }} {
    width: 100%;
    height: {{ block.settings.feature_height }}px;
    object-fit: cover;
    display: block;
  }

  .ai-magazine-feature-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: {{ block.settings.feature_height }}px;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-magazine-feature-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-magazine-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-magazine-feature-content-{{ ai_gen_id }} {
    padding: {{ block.settings.content_padding }}px 0;
  }

  .ai-magazine-category-{{ ai_gen_id }} {
    display: inline-block;
    font-size: {{ block.settings.category_size }}px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: {{ block.settings.accent_color }};
    margin-bottom: 12px;
  }

  .ai-magazine-feature-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.feature_title_size }}px;
    line-height: 1.2;
    margin: 0 0 16px;
    color: {{ block.settings.text_color }};
    font-weight: 700;
  }

  .ai-magazine-feature-excerpt-{{ ai_gen_id }} {
    font-size: {{ block.settings.excerpt_size }}px;
    line-height: 1.6;
    color: {{ block.settings.text_color }};
    opacity: 0.8;
    margin-bottom: 20px;
  }

  .ai-magazine-meta-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 16px;
    font-size: {{ block.settings.meta_size }}px;
    color: {{ block.settings.text_color }};
    opacity: 0.6;
  }

  .ai-magazine-sidebar-{{ ai_gen_id }} {
    grid-column: span 4;
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.sidebar_gap }}px;
  }

  .ai-magazine-sidebar-item-{{ ai_gen_id }} {
    display: flex;
    gap: 16px;
  }

  .ai-magazine-sidebar-image-{{ ai_gen_id }} {
    width: {{ block.settings.sidebar_image_size }}px;
    height: {{ block.settings.sidebar_image_size }}px;
    object-fit: cover;
    flex-shrink: 0;
  }

  .ai-magazine-sidebar-placeholder-{{ ai_gen_id }} {
    width: {{ block.settings.sidebar_image_size }}px;
    height: {{ block.settings.sidebar_image_size }}px;
    background-color: #f4f4f4;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-magazine-sidebar-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-magazine-sidebar-content-{{ ai_gen_id }} {
    flex: 1;
  }

  .ai-magazine-sidebar-category-{{ ai_gen_id }} {
    font-size: {{ block.settings.sidebar_category_size }}px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: {{ block.settings.accent_color }};
    margin-bottom: 8px;
  }

  .ai-magazine-sidebar-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.sidebar_title_size }}px;
    line-height: 1.3;
    margin: 0 0 8px;
    color: {{ block.settings.text_color }};
    font-weight: 600;
  }

  .ai-magazine-sidebar-meta-{{ ai_gen_id }} {
    font-size: {{ block.settings.sidebar_meta_size }}px;
    color: {{ block.settings.text_color }};
    opacity: 0.6;
  }

  .ai-magazine-divider-{{ ai_gen_id }} {
    height: 1px;
    background-color: {{ block.settings.text_color }};
    opacity: 0.1;
    margin: {{ block.settings.divider_spacing }}px 0;
  }

  @media screen and (max-width: 989px) {
    .ai-magazine-feature-{{ ai_gen_id }} {
      grid-column: span 12;
    }

    .ai-magazine-sidebar-{{ ai_gen_id }} {
      grid-column: span 12;
    }

    .ai-magazine-feature-image-{{ ai_gen_id }},
    .ai-magazine-feature-placeholder-{{ ai_gen_id }} {
      height: {{ block.settings.feature_height | times: 0.7 }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-magazine-layout-{{ ai_gen_id }} {
      padding: {{ block.settings.spacing | times: 0.6 }}px;
    }

    .ai-magazine-grid-{{ ai_gen_id }} {
      gap: {{ block.settings.grid_gap | times: 0.6 }}px;
    }

    .ai-magazine-feature-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.feature_title_size | times: 0.7 }}px;
    }

    .ai-magazine-feature-image-{{ ai_gen_id }},
    .ai-magazine-feature-placeholder-{{ ai_gen_id }} {
      height: {{ block.settings.feature_height | times: 0.5 }}px;
    }

    .ai-magazine-sidebar-item-{{ ai_gen_id }} {
      flex-direction: column;
    }

    .ai-magazine-sidebar-image-{{ ai_gen_id }},
    .ai-magazine-sidebar-placeholder-{{ ai_gen_id }} {
      width: 100%;
      height: 200px;
    }
  }
{% endstyle %}

<div class="ai-magazine-layout-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-magazine-grid-{{ ai_gen_id }}">
    <article class="ai-magazine-feature-{{ ai_gen_id }}">
      {% if block.settings.feature_image %}
        <img
          src="{{ block.settings.feature_image | image_url: width: 1200 }}"
          alt="{{ block.settings.feature_image.alt | escape }}"
          class="ai-magazine-feature-image-{{ ai_gen_id }}"
          loading="lazy"
          width="{{ block.settings.feature_image.width }}"
          height="{{ block.settings.feature_image.height }}"
        >
      {% else %}
        <div class="ai-magazine-feature-placeholder-{{ ai_gen_id }}">
          {{ 'hero-apparel-1' | placeholder_svg_tag }}
          <div class="ai-magazine-empty-state-{{ ai_gen_id }}">
            Add a featured image
          </div>
        </div>
      {% endif %}

      <div class="ai-magazine-feature-content-{{ ai_gen_id }}">
        {% if block.settings.feature_category != blank %}
          <span class="ai-magazine-category-{{ ai_gen_id }}">{{ block.settings.feature_category }}</span>
        {% endif %}

        {% if block.settings.feature_title != blank %}
          <h2 class="ai-magazine-feature-title-{{ ai_gen_id }}">{{ block.settings.feature_title }}</h2>
        {% endif %}

        {% if block.settings.feature_excerpt != blank %}
          <div class="ai-magazine-feature-excerpt-{{ ai_gen_id }}">{{ block.settings.feature_excerpt }}</div>
        {% endif %}

        <div class="ai-magazine-meta-{{ ai_gen_id }}">
          {% if block.settings.feature_author != blank %}
            <span>{{ block.settings.feature_author }}</span>
          {% endif %}
          {% if block.settings.feature_date != blank %}
            <span>{{ block.settings.feature_date }}</span>
          {% endif %}
        </div>
      </div>
    </article>

    <aside class="ai-magazine-sidebar-{{ ai_gen_id }}">
      {% for i in (1..3) %}
        {% liquid
          assign image_key = 'sidebar_image_' | append: i
          assign category_key = 'sidebar_category_' | append: i
          assign title_key = 'sidebar_title_' | append: i
          assign date_key = 'sidebar_date_' | append: i

          assign sidebar_image = block.settings[image_key]
          assign sidebar_category = block.settings[category_key]
          assign sidebar_title = block.settings[title_key]
          assign sidebar_date = block.settings[date_key]
        %}

        <article class="ai-magazine-sidebar-item-{{ ai_gen_id }}">
          {% if sidebar_image %}
            <img
              src="{{ sidebar_image | image_url: width: 400 }}"
              alt="{{ sidebar_image.alt | escape }}"
              class="ai-magazine-sidebar-image-{{ ai_gen_id }}"
              loading="lazy"
              width="{{ sidebar_image.width }}"
              height="{{ sidebar_image.height }}"
            >
          {% else %}
            <div class="ai-magazine-sidebar-placeholder-{{ ai_gen_id }}">
              {{ 'product-apparel-1' | placeholder_svg_tag }}
            </div>
          {% endif %}

          <div class="ai-magazine-sidebar-content-{{ ai_gen_id }}">
            {% if sidebar_category != blank %}
              <div class="ai-magazine-sidebar-category-{{ ai_gen_id }}">{{ sidebar_category }}</div>
            {% endif %}

            {% if sidebar_title != blank %}
              <h3 class="ai-magazine-sidebar-title-{{ ai_gen_id }}">{{ sidebar_title }}</h3>
            {% endif %}

            {% if sidebar_date != blank %}
              <div class="ai-magazine-sidebar-meta-{{ ai_gen_id }}">{{ sidebar_date }}</div>
            {% endif %}
          </div>
        </article>

        {% if i < 3 %}
          <div class="ai-magazine-divider-{{ ai_gen_id }}"></div>
        {% endif %}
      {% endfor %}
    </aside>
  </div>
</div>

