<section class="py-20">
    <div class="max-w-7xl mx-auto px-6">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-stretch">
  
        <!-- LEFT CONTENT -->
        <div class="bg-black text-white p-12 flex flex-col justify-center">
          {% if section.settings.heading != blank %}
            <h2 class="text-4xl font-semibold mb-4">
              {{ section.settings.heading }}
            </h2>
          {% endif %}
  
          {% if section.settings.description != blank %}
            <p class="text-gray-300 mb-8 max-w-md">
              {{ section.settings.description }}
            </p>
          {% endif %}
  
          {% if section.settings.button_text != blank %}
            <a
              href="{{ section.settings.button_link }}"
              class="inline-block border border-white px-8 py-3 text-sm w-max hover:bg-white hover:text-black transition"
            >
              {{ section.settings.button_text }}
            </a>
          {% endif %}
        </div>
  
        <!-- RIGHT IMAGE GRID -->
        <div class="grid grid-cols-6 grid-rows-2 gap-4">

            {% if section.settings.image_1 %}
            <div class="col-span-4 row-span-1 bg-gray-100">
                <img
                src="{{ section.settings.image_1 | image_url: width: 1200 }}"
                alt=""
                class="w-full h-full object-cover"
                >
            </div>
            {% endif %}
        
            {% if section.settings.image_2 %}
            <div class="col-span-2 row-span-1 bg-gray-100">
                <img
                src="{{ section.settings.image_2 | image_url: width: 800 }}"
                alt=""
                class="w-full h-full object-cover"
                >
            </div>
            {% endif %}
        
            {% if section.settings.image_3 %}
            <div class="col-span-2 row-span-1 bg-gray-100">
                <img
                src="{{ section.settings.image_3 | image_url: width: 600 }}"
                alt=""
                class="w-full h-full object-cover"
                >
            </div>
            {% endif %}
        
            {% if section.settings.image_4 %}
            <div class="col-span-4 row-span-1 bg-gray-100">
                <img
                src="{{ section.settings.image_4 | image_url: width: 1200 }}"
                alt=""
                class="w-full h-full object-cover"
                >
            </div>
            {% endif %}
        
        </div>
        
  
      </div>
    </div>
  </section>
  
  {% schema %}
  {
    "name": "Summer Collection Grid",
    "settings": [
      {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default": "Introducing Our Summer Collection, Now available!"
      },
      {
        "type": "textarea",
        "id": "description",
        "label": "Description",
        "default": "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sollicitudin odio pellentesque nec sed."
      },
      {
        "type": "text",
        "id": "button_text",
        "label": "Button text",
        "default": "SHOP NOW"
      },
      {
        "type": "url",
        "id": "button_link",
        "label": "Button link"
      },
      {
        "type": "image_picker",
        "id": "image_1",
        "label": "Image 1 (Top left)"
      },
      {
        "type": "image_picker",
        "id": "image_2",
        "label": "Image 2 (Top right)"
      },
      {
        "type": "image_picker",
        "id": "image_3",
        "label": "Image 3 (Bottom left)"
      },
      {
        "type": "image_picker",
        "id": "image_4",
        "label": "Image 4 (Bottom right)"
      }
    ],
    "presets": [
      {
        "name": "Summer Collection Grid"
      }
    ]
  }
  {% endschema %}
  