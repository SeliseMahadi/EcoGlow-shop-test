<section class="w-full bg-gray-200 mt-[46px] hero-section-big-img-section">
    <div class="max-w-7xl mx-auto px-6 grid md:grid-cols-2 gap-10 items-center">
  
      <!-- LEFT CONTENT -->
      <!-- LEFT CONTENT -->
    <div class="space-y-6 hero-section-big-img-left-content">
        <h1 class="text-4xl md:text-5xl font-bold">
          {{ section.settings.heading }}
        </h1>
  
        <p class="text-gray-600 leading-relaxed max-w-md">
          {{ section.settings.description }}
        </p>
  
        {% if section.settings.button_text != blank %}
          <a href="{{ section.settings.button_link }}"
             class="inline-block bg-black text-white px-8 py-3 text-sm font-medium tracking-wider hover:bg-gray-800 transition">
            {{ section.settings.button_text }}
          </a>
        {% endif %}
      </div>
  
  
      <!-- RIGHT IMAGE -->
      <div class="flex justify-center md:justify-end hero-section-big-img-right-image">
        {% if section.settings.hero_image %}
          <img
            src="{{ section.settings.hero_image | image_url: width: 1000, height: 1000 }}"
            alt="New Arrival"
            class="max-w-full  mt-[-80px] h-auto object-contain hero-section-big-img-image hero-section-big-img-image-width-1000 hero-section-big-img-image-height-1000"
          >
        {% endif %}
      </div>
  
    </div>
  </section>

{% schema %}
{
  "name": "Hero Section Big Img",
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "New Arrival"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Add your section description here."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
  ],
  "presets": [
    {
      "name": "Hero Section Big Img"
    }
  ]
}
{% endschema %}
  