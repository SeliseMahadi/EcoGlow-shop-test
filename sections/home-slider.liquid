<section class="home-slider">
<div class="slider-container">
{% for block in section.blocks %}
<div class="slide">
{% if block.settings.image != blank %}
{{ block.settings.image | image_url: width: 1600 | image_tag: alt: block.settings.heading, class: 'slide-img' }}
{% endif %}
<div class="slide-content">
<h2>{{ block.settings.heading }}</h2>
<p>{{ block.settings.subheading }}</p>
{% if block.settings.button_label != blank and block.settings.button_link != blank %}
<a href="{{ block.settings.button_link }}" class="btn">{{ block.settings.button_label }}</a>
{% endif %}
</div>
</div>
{% endfor %}
</div>
</section>


{% schema %}
{
"name": "Homepage — Slider",
"blocks": [
{
"type": "slide",
"name": "Slide",
"settings": [
{ "type": "image_picker", "id": "image", "label": "Slide image" },
{ "type": "text", "id": "heading", "label": "Heading", "default": "Slide heading" },
{ "type": "text", "id": "subheading", "label": "Subheading", "default": "Slide subheading" },
{ "type": "url", "id": "button_link", "label": "Button link" },
{ "type": "text", "id": "button_label", "label": "Button label", "default": "Shop now" }
]
}
],
"max_blocks": 5,
"presets": [
{ "name": "Homepage — Slider", "category": "Homepage" }
]
}
{% endschema %}